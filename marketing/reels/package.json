{
  "name": "ort-tech-reels",
  "version": "1.0.0",
  "private": true,
  "description": "Vertical promo reels for ORT-TECH, rendered with Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:reel": "remotion render src/index.ts OT01-LeadAt2314 out/ot01-lead-at-2314.mp4",
    "render:cover": "remotion still src/index.ts OT01-LeadAt2314 out/ot01-lead-at-2314-cover.png --frame=95"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@remotion/cli": "4.0.512",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.512"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
